# Copy to .env for local development. Never commit .env.

# Secret used to sign login sessions. Use a long random string in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
LIS_SECRET=change-me

# Optional locally (SQLite lis.db is used when this is empty).
# Required on Vercel: your Supabase Postgres connection string
# (Supabase > Project Settings > Database > Connection string > Transaction pooler).
DATABASE_URL=
